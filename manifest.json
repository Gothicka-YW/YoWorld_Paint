{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "name": "YoWorld Paint",
  "description": "Fan-made YoWorld tool to create, preview, transform, split, upload, and export custom Paint Boards and Sales Boards.",
  "version": "3.5.11",
  "version_name": "v3.5.11",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "icons": {
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {
    "default_title": "Open YoWorld Paint side panel"
  },
  "side_panel": {
    "default_path": "popup/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.yoworld.com/*",
    "https://api.yoworld.info/*",
    "https://yoworld.com/*",
    "https://api.imgbb.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "https://picrd.com/*"
  ]
}
